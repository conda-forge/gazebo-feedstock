From 34428cea4b88873952b6ccede1aaf543fb02ad44 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <info@tobiasfischer.info>
Date: Sat, 21 Nov 2026 10:10:18 +0000
Subject: [PATCH 1/5] CMake: build against Qt 6 (Core5Compat) instead of Qt 5

Map the Qt5* variables to Qt6 imported targets, use qt_add_resources,
link gzqtpropertybrowser to Qt explicitly.
---
 cmake/SearchForStuff.cmake                  | 13 ++++++++++++-
 gazebo/gui/CMakeLists.txt                   |  2 +-
 gazebo/gui/qtpropertybrowser/CMakeLists.txt |  3 ++-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/cmake/SearchForStuff.cmake b/cmake/SearchForStuff.cmake
index 054f0ad..02b23a0 100644
--- a/cmake/SearchForStuff.cmake
+++ b/cmake/SearchForStuff.cmake
@@ -655,7 +655,18 @@ endif()
 
 ########################################
 # Find QT
-find_package(Qt5 COMPONENTS Core Widgets OpenGL Test REQUIRED)
+# Qt 6 port: find Qt6 and keep the historic Qt5* variable names used
+# throughout the tree, pointing them at the Qt6 imported targets.
+find_package(Qt6 COMPONENTS Core Gui Widgets OpenGL OpenGLWidgets Test Core5Compat REQUIRED)
+set(Qt5Core_LIBRARIES Qt6::Core Qt6::Core5Compat)
+set(Qt5Widgets_LIBRARIES Qt6::Gui Qt6::Widgets Qt6::OpenGL Qt6::OpenGLWidgets)
+set(Qt5Test_LIBRARIES Qt6::Test)
+set(Qt5Core_INCLUDE_DIRS
+  "$<TARGET_PROPERTY:Qt6::Core,INTERFACE_INCLUDE_DIRECTORIES>"
+  "$<TARGET_PROPERTY:Qt6::Gui,INTERFACE_INCLUDE_DIRECTORIES>"
+  "$<TARGET_PROPERTY:Qt6::Widgets,INTERFACE_INCLUDE_DIRECTORIES>"
+  "$<TARGET_PROPERTY:Qt6::Core5Compat,INTERFACE_INCLUDE_DIRECTORIES>")
+set(Qt5Core_DEFINITIONS "")
 
 ########################################
 # Find Boost, if not specified manually
diff --git a/gazebo/gui/CMakeLists.txt b/gazebo/gui/CMakeLists.txt
index 3135957..873dc61 100644
--- a/gazebo/gui/CMakeLists.txt
+++ b/gazebo/gui/CMakeLists.txt
@@ -194,7 +194,7 @@ gz_build_qt_tests(${qt_tests})
 
 set (resources resources.qrc)
 
-QT5_ADD_RESOURCES(resources_RCC ${resources})
+qt_add_resources(resources_RCC ${resources})
 
 gz_add_library(gazebo_gui ${sources} ${resources_RCC})
 set_target_properties(gazebo_gui PROPERTIES COMPILE_DEFINITIONS "QWT_DLL")
diff --git a/gazebo/gui/qtpropertybrowser/CMakeLists.txt b/gazebo/gui/qtpropertybrowser/CMakeLists.txt
index 6c03b84..8230686 100644
--- a/gazebo/gui/qtpropertybrowser/CMakeLists.txt
+++ b/gazebo/gui/qtpropertybrowser/CMakeLists.txt
@@ -23,10 +23,11 @@ set (qt_headers qtpropertybrowser.h
   )
 
 set (resources qtpropertybrowser.qrc)
-QT5_ADD_RESOURCES(resources_RCC ${resources})
+qt_add_resources(resources_RCC ${resources})
 
 add_library(gzqtpropertybrowser STATIC ${sources} ${resources_RCC})
 set_target_properties(gzqtpropertybrowser PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_link_libraries(gzqtpropertybrowser PUBLIC ${Qt5Core_LIBRARIES} ${Qt5Widgets_LIBRARIES})
 # Visual Studio enables c++11 support by default
 if (NOT MSVC)
   if(CMAKE_VERSION VERSION_LESS 3.8.2)
-- 
